DATABASE_URL=

JWT_SECRET=
INTERNAL_API_SECRET=

GEMINI_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Google Calendar sync (doctors connect their calendar from their profile page).
# Same Google Cloud project as the frontend's NextAuth Google provider works fine —
# just add GOOGLE_CALENDAR_REDIRECT_URI as an authorized redirect URI, and enable the
# Google Calendar API on that project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4002/calendar/oauth/callback
# base64-encoded 32-byte key used to encrypt stored refresh tokens, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_KEY=
# Where /calendar/oauth/callback redirects back to after connecting/failing.
FRONTEND_URL=http://localhost:3000

PORT=4002
